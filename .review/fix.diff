+            .expect_err("short stream must fail the chunk");
+        assert!(
+            err.to_string().contains("short read"),
+            "error should name the short read: {err}"
+        );
+        assert_eq!(
+            knobs.seen.lock().unwrap().last().unwrap(),
+            "bytes=1024-2047"
+        );
+        std::fs::remove_dir_all(&dir).unwrap();
